# ---------------------------------------------------------------------------
# AgentOps example environment. Copy to backend/.env and fill in real values.
# NEVER commit a filled-in copy: .env is git-ignored.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
APP_NAME=agentops
API_PREFIX=/api/v1

# Comma-separated list of allowed browser origins (CSRF/CORS boundary).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database --------------------------------------------------------------
# psycopg3 async driver.
DATABASE_URL=postgresql+psycopg://agentops:agentops_local_dev@127.0.0.1:5432/agentops
TEST_DATABASE_URL=postgresql+psycopg://agentops:agentops_local_dev@127.0.0.1:5432/agentops_test
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_ECHO=false

# --- Security --------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-me-with-48-byte-random-string
# Argon2id parameters (tunable; defaults shown)
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4
SESSION_TTL_HOURS=24
COOKIE_SECURE=false          # set true when serving over HTTPS
COOKIE_SAMESITE=lax

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=10

# --- Model providers -------------------------------------------------------
# Secrets are never stored in the database as plaintext; only a reference is.
# Register providers through the UI or API so the secret reference is created.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=120
DEFAULT_MODEL_PROVIDER_TYPE=ollama
DEFAULT_MODEL_NAME=qwen2.5:7b-instruct

# --- Background jobs -------------------------------------------------------
JOB_WORKER_ENABLED=true
JOB_WORKER_CONCURRENCY=4
JOB_LEASE_SECONDS=120
JOB_MAX_ATTEMPTS=5

# --- Object storage (knowledge uploads) ------------------------------------
STORAGE_ROOT=./var/storage
STORAGE_MAX_UPLOAD_MB=25

# --- Frontend (build-time) -------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME=AgentOps
