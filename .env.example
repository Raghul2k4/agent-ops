# ---------------------------------------------------------------------------
# AgentOps example environment.
#
# Copy the relevant block into `backend/.env` (server, git-ignored) and
# `apps/web/.env` (browser, git-ignored). NEVER commit a filled-in copy and
# never put a server-only value in a `VITE_` variable.
# ---------------------------------------------------------------------------

# ===========================================================================
# backend/.env  -  FastAPI service
# ===========================================================================

# --- Application -----------------------------------------------------------
ENVIRONMENT=development          # development | test | staging | production
DEBUG=false
LOG_LEVEL=INFO
APP_NAME=agentops
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database --------------------------------------------------------------
# Deployed: Supabase Postgres through the *transaction* pooler (port 6543):
#   postgresql+psycopg://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# The direct host (`db.<ref>.supabase.co`) is IPv6-only on hobby projects and is
# not used by the application. Migrations use the *session* pooler (port 5432)
# through the Supabase CLI.
DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:6543/<database>?sslmode=require
# Disposable database used only by the test suite. Never point this at the
# hosted project: the fixtures truncate tables.
TEST_DATABASE_URL=postgresql+psycopg://agentops@127.0.0.1:55432/agentops_test
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_ECHO=false
DB_STATEMENT_TIMEOUT_MS=15000
DB_IDLE_TX_TIMEOUT_MS=30000

# --- Identity --------------------------------------------------------------
# supabase: Supabase Auth owns identity; the API verifies tokens via JWKS.
# local:    development/test-only HS256 issuer, rejected in staging/production.
AUTH_MODE=supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_CACHE_SECONDS=600
# Optional overrides (derived from SUPABASE_URL when omitted):
# SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1

# Development-only credential issuer (AUTH_MODE=local). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
LOCAL_JWT_SECRET=<development-only-random-value>
LOCAL_JWT_ISSUER=agentops-local
LOCAL_JWT_TTL_MINUTES=480
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=10

# --- Model providers (later milestones) ------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=120
DEFAULT_MODEL_PROVIDER_TYPE=ollama
DEFAULT_MODEL_NAME=qwen2.5:7b-instruct

# --- Background jobs -------------------------------------------------------
JOB_WORKER_ENABLED=true
JOB_WORKER_CONCURRENCY=4
JOB_LEASE_SECONDS=120
JOB_MAX_ATTEMPTS=5

# --- Storage ---------------------------------------------------------------
STORAGE_ROOT=./var/storage
STORAGE_MAX_UPLOAD_MB=25

# --- Server-only Supabase values (NOT needed by the API in M1) --------------
# Used by the Supabase CLI / migrations / future privileged operations.
# Never add these to apps/web/.env and never prefix them with VITE_.
# SUPABASE_SECRET_KEY=
# SUPABASE_DB_PASSWORD=
# SUPABASE_DB_URL=
# SUPABASE_POOLER_URL=
# SUPABASE_ACCESS_TOKEN=

# ===========================================================================
# apps/web/.env  -  browser bundle (public values only)
# ===========================================================================
# VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1   # default /api/v1 (dev proxy)
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=<sb_publishable_...>
